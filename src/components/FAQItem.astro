---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="faq-item" data-faq-item>
  <summary class="faq-question">
    <span>{question}</span>
    <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </summary>
  <div class="faq-answer">
    <p>{answer}</p>
  </div>
</details>

<style>
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    cursor: pointer;
    font-family: var(--font-family);
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text-primary);
    list-style: none;
    transition: color var(--transition-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--color-brand-500);
  }

  .faq-question:hover .faq-chevron {
    stroke: var(--color-brand-500);
    transform: scale(1.1);
  }

  .faq-question:focus {
    outline: none;
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .faq-chevron {
    stroke: var(--color-brand-700);
    flex-shrink: 0;
    margin-left: 8px;
    transition: transform var(--transition-normal), stroke var(--transition-fast);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 0 24px 0;
    color: var(--color-text-secondary);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-normal) ease-out, padding var(--transition-normal) ease-out;
  }

  .faq-item[open] .faq-answer {
    max-height: 500px;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-chevron,
    .faq-answer {
      transition: none !important;
    }
  }
</style>