---
import EmbryoLogo from './EmbryoLogo.astro';
---

<header class="site-header">
  <div class="header-container">
    <!-- Left Section: Logo + Main Navigation Links -->
    <div class="header-left">
      <a href="/" class="logo-link" aria-label="EmbryoOne Home">
        <EmbryoLogo height={28} />
      </a>

      <nav class="nav-menu" aria-label="Main Navigation">
        <a href="#platform" class="nav-link">
          Solutions
          <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" class="caret-icon">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </a>
        <a href="#resources" class="nav-link">
          Resources
          <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" class="caret-icon">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </a>
        <a href="#hardware" class="nav-link">Community</a>
        <a href="#enterprise" class="nav-link">Enterprise</a>
        <a href="#pricing" class="nav-link">Pricing</a>
        <a href="#security" class="nav-link">Security</a>
      </nav>
    </div>

    <!-- Right Section: Sign In & Get Started Action Buttons -->
    <div class="header-right">
      <a href="#signin" class="btn-outlined">Sign in</a>
      <a href="#get-started" class="btn-solid">
        Get started
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none" class="btn-arrow">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    height: 72px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(24, 19, 48, 0.06);
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  .header-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .logo-link:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14.5px;
    font-weight: 500;
    color: #5C5566;
    padding: 8px 14px;
    border-radius: 10px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: #181330;
    background-color: rgba(203, 108, 230, 0.08);
  }

  .caret-icon {
    opacity: 0.55;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .nav-link:hover .caret-icon {
    opacity: 1;
    transform: translateY(1px);
    color: #CB6CE6;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  /* Sleek Outlined "Sign in" Button */
  .btn-outlined {
    font-size: 14px;
    font-weight: 500;
    color: #181330;
    background-color: #FFFFFF;
    border: 1px solid rgba(24, 19, 48, 0.12);
    padding: 8px 20px;
    border-radius: 9999px;
    box-shadow: 0 1px 3px rgba(18, 12, 31, 0.04);
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .btn-outlined:hover {
    background-color: #FAF8F5;
    border-color: rgba(24, 19, 48, 0.2);
    transform: translateY(-1px);
  }

  /* Vibrant EmbryoOne Brand Gradient "Get started" Button */
  .btn-solid {
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
    background: linear-gradient(135deg, #CB6CE6 0%, #AD52D0 100%);
    border: none;
    padding: 8px 22px;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(203, 108, 230, 0.32);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .btn-arrow {
    transition: transform 0.15s ease;
  }

  .btn-solid:hover {
    background: linear-gradient(135deg, #AD52D0 0%, #9A4DC1 100%);
    box-shadow: 0 6px 20px rgba(203, 108, 230, 0.42);
    transform: translateY(-1px);
  }

  .btn-solid:hover .btn-arrow {
    transform: translateX(2px);
  }

  .btn-solid:active {
    transform: translateY(1px);
  }

  @media (max-width: 1023px) {
    .header-container {
      padding: 0 24px;
    }
    .header-left {
      gap: 20px;
    }
    .nav-menu {
      gap: 2px;
    }
    .nav-link {
      padding: 6px 8px;
    }
  }

  @media (max-width: 840px) {
    .nav-menu {
      display: none;
    }
  }
</style>
