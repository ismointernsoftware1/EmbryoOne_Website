---
---

<div class="hero-network-container" aria-hidden="true">
  <svg 
    class="network-svg"
    viewBox="0 0 1280 450" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <!-- Light Beam Head Gradients for the 6 EmbryoOne Domain Nodes -->
      <!-- 1. AI Intelligence (Vivid Orchid #C759E1) -->
      <linearGradient id="beamGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#C759E1" stop-opacity="0" />
        <stop offset="70%" stop-color="#C759E1" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
      </linearGradient>

      <!-- 2. Hardware (Amethyst #9A4DC1) -->
      <linearGradient id="beamGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#9A4DC1" stop-opacity="0" />
        <stop offset="70%" stop-color="#9A4DC1" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
      </linearGradient>

      <!-- 3. IoT (Embryo Purple #CB6CE6) -->
      <linearGradient id="beamGrad3" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#CB6CE6" stop-opacity="0" />
        <stop offset="70%" stop-color="#CB6CE6" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
      </linearGradient>

      <!-- 4. Automation (Violet #DB97F5) -->
      <linearGradient id="beamGrad4" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#DB97F5" stop-opacity="0" />
        <stop offset="70%" stop-color="#DB97F5" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
      </linearGradient>

      <!-- 5. Analytics (Lavender Purple 2 #A35AC8) -->
      <linearGradient id="beamGrad5" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#A35AC8" stop-opacity="0" />
        <stop offset="70%" stop-color="#A35AC8" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
      </linearGradient>

      <!-- 6. Connected Devices (Iris #5B3AC4) -->
      <linearGradient id="beamGrad6" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#5B3AC4" stop-opacity="0" />
        <stop offset="70%" stop-color="#5B3AC4" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
      </linearGradient>

      <!-- Convergence Focal Point Radial Glow -->
      <radialGradient id="focalGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#CB6CE6" stop-opacity="0.4" />
        <stop offset="60%" stop-color="#C759E1" stop-opacity="0.15" />
        <stop offset="100%" stop-color="#CB6CE6" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Convergence Focal Point Glow at the bottom center horizon (entering top edge of lower application window at y=440px) -->
    <circle cx="640" cy="440" r="50" fill="url(#focalGlow)" class="focal-glow-pulse" />
    <circle cx="640" cy="440" r="4" fill="#CB6CE6" />
    <circle cx="640" cy="440" r="8" stroke="#DB97F5" stroke-width="1" fill="none" opacity="0.6" />

    <!-- LAYER 1 — STATIC BASE PATHS (Subtle, low-opacity gray/lavender static SVG paths sweeping inward in gentle arcing Bezier curves beneath text & CTAs) -->
    <!-- Left Cluster Base Paths -->
    <path d="M 150 80 C 300 110, 460 260, 640 440" stroke="var(--color-parchment-border)" stroke-width="1.25" opacity="0.35" class="base-path" />
    <path d="M 278 210 C 380 230, 500 300, 640 440" stroke="var(--color-parchment-border)" stroke-width="1.25" opacity="0.35" class="base-path" />
    <path d="M 188 340 C 320 360, 500 380, 640 440" stroke="var(--color-parchment-border)" stroke-width="1.25" opacity="0.35" class="base-path" />

    <!-- Right Cluster Base Paths -->
    <path d="M 1130 80 C 960 110, 800 260, 640 440" stroke="var(--color-parchment-border)" stroke-width="1.25" opacity="0.35" class="base-path" />
    <path d="M 1002 210 C 900 230, 760 300, 640 440" stroke="var(--color-parchment-border)" stroke-width="1.25" opacity="0.35" class="base-path" />
    <path d="M 1092 340 C 960 360, 780 380, 640 440" stroke="var(--color-parchment-border)" stroke-width="1.25" opacity="0.35" class="base-path" />

    <!-- LAYER 2 — LIGHT BEAM DRAW (Concentrated glowing gradient heads initiating from 6 icons & tracing along designated paths simultaneously toward bottom-center horizon) -->
    <!-- Beam 1: AI Intelligence (Vivid Orchid #C759E1) -->
    <path 
      d="M 150 80 C 300 110, 460 260, 640 440" 
      stroke="url(#beamGrad1)" 
      stroke-width="2.5" 
      stroke-linecap="round"
      pathLength="1000"
      class="beam-path beam-1"
    />

    <!-- Beam 2: Hardware (Amethyst #9A4DC1) -->
    <path 
      d="M 278 210 C 380 230, 500 300, 640 440" 
      stroke="url(#beamGrad2)" 
      stroke-width="2.5" 
      stroke-linecap="round"
      pathLength="1000"
      class="beam-path beam-2"
    />

    <!-- Beam 3: IoT (Embryo Purple #CB6CE6) -->
    <path 
      d="M 188 340 C 320 360, 500 380, 640 440" 
      stroke="url(#beamGrad3)" 
      stroke-width="2.5" 
      stroke-linecap="round"
      pathLength="1000"
      class="beam-path beam-3"
    />

    <!-- Beam 4: Automation (Violet #DB97F5) -->
    <path 
      d="M 1130 80 C 960 110, 800 260, 640 440" 
      stroke="url(#beamGrad4)" 
      stroke-width="2.5" 
      stroke-linecap="round"
      pathLength="1000"
      class="beam-path beam-4"
    />

    <!-- Beam 5: Analytics (Lavender Purple 2 #A35AC8) -->
    <path 
      d="M 1002 210 C 900 230, 760 300, 640 440" 
      stroke="url(#beamGrad5)" 
      stroke-width="2.5" 
      stroke-linecap="round"
      pathLength="1000"
      class="beam-path beam-5"
    />

    <!-- Beam 6: Connected Devices (Iris #5B3AC4) -->
    <path 
      d="M 1092 340 C 960 360, 780 380, 640 440" 
      stroke="url(#beamGrad6)" 
      stroke-width="2.5" 
      stroke-linecap="round"
      pathLength="1000"
      class="beam-path beam-6"
    />
  </svg>
</div>

<style>
  .hero-network-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 5;
  }

  .network-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Light Beam Draw paths: short glowing head pulse (90px beam over 1000px pathLength) */
  .beam-path {
    stroke-dasharray: 90 910;
    will-change: stroke-dashoffset, opacity;
  }

  .beam-1 { animation: beamDraw 3.2s linear infinite; animation-delay: 0s; }
  .beam-2 { animation: beamDraw 3.6s linear infinite; animation-delay: -0.6s; }
  .beam-3 { animation: beamDraw 3.9s linear infinite; animation-delay: -1.2s; }
  .beam-4 { animation: beamDraw 3.0s linear infinite; animation-delay: -1.8s; }
  .beam-5 { animation: beamDraw 3.7s linear infinite; animation-delay: -2.4s; }
  .beam-6 { animation: beamDraw 3.4s linear infinite; animation-delay: -3.0s; }

  @keyframes beamDraw {
    0% {
      stroke-dashoffset: 1000;
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    94% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  .focal-glow-pulse {
    animation: glowBreathe 3s ease-in-out infinite alternate;
  }

  @keyframes glowBreathe {
    0% {
      transform: scale(0.92);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.15);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .beam-path, .focal-glow-pulse {
      animation: none !important;
    }
  }
</style>
