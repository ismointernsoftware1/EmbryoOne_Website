---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "dark" | "ghost" | "outline";
  size?: "sm" | "md" | "lg";
  hasArrow?: boolean;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  hasArrow = false,
  type = "button",
  ariaLabel,
  class: className = ""
} = Astro.props;

const classes = [
  "eo-btn",
  `btn-${variant}`,
  `btn-${size}`,
  className
].filter(Boolean).join(" ");
---

{href ? (
  <a href={href} class={classes} aria-label={ariaLabel}>
    <slot />
    {hasArrow && (
      <svg viewBox="0 0 24 24" class="btn-arrow" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    )}
  </a>
) : (
  <button type={type} class={classes} aria-label={ariaLabel}>
    <slot />
    {hasArrow && (
      <svg viewBox="0 0 24 24" class="btn-arrow" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    )}
  </button>
)}

<style>
  .eo-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-primary, inherit);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
    box-sizing: border-box;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Sizes */
  .btn-sm {
    height: 36px;
    padding: 0 16px;
    font-size: 13.5px;
    border-radius: var(--radius-sm, 8px);
  }

  .btn-md {
    height: 44px;
    padding: 0 22px;
    font-size: 14.5px;
    border-radius: 10px;
  }

  .btn-lg {
    height: 48px;
    padding: 0 26px;
    font-size: 15.5px;
    font-weight: 700;
    border-radius: 12px;
  }

  /* Primary: EmbryoOne Brand Purple with Glow */
  .btn-primary {
    background-color: var(--color-brand, #CB6CE6);
    color: var(--color-white, #FFFFFF);
    font-weight: 700;
    border: 1px solid transparent;
    box-shadow: var(--shadow-md, 0 4px 16px rgba(18, 12, 31, 0.06));
  }

  .btn-primary:hover {
    background-color: var(--color-brand-hover, #AD52D0);
    box-shadow: var(--shadow-lg, 0 16px 48px rgba(18, 12, 31, 0.14)), var(--shadow-glow, 0 0 24px rgba(203, 108, 230, 0.18));
    transform: translateY(-1px);
  }

  .btn-primary:active {
    background-color: var(--color-brand-active, #A35AC8);
    transform: translateY(1px);
  }

  /* Secondary: Soft Lavender / Twilight */
  .btn-secondary {
    background-color: var(--color-lavender, #F3E6FB);
    color: var(--color-twilight, #3B2166);
    border: 1px solid var(--color-mist, #E4DFEA);
    font-weight: 500;
  }

  .btn-secondary:hover {
    background-color: var(--color-mist, #E4DFEA);
    border-color: #D3C9DC;
    transform: translateY(-1px);
  }

  /* Dark / Eggplant CTA Button */
  .btn-dark {
    background-color: #3D2652;
    color: #FFFFFF;
    font-weight: 600;
    border: 1px solid #3D2652;
    border-radius: 9999px;
    box-shadow: 0 1px 3px rgba(61, 38, 82, 0.18);
  }

  .btn-dark:hover {
    background-color: #2D1A3E;
    border-color: #2D1A3E;
    box-shadow: 0 4px 14px rgba(61, 38, 82, 0.25);
    transform: translateY(-1px);
  }

  /* Ghost: Subtle link button */
  .btn-ghost {
    background: transparent;
    color: var(--color-ink, #181330);
    border: 1px solid transparent;
    font-weight: 500;
  }

  .btn-ghost:hover {
    background-color: rgba(24, 19, 48, 0.05);
    color: #111827;
  }

  /* Outline Button */
  .btn-outline {
    background: #FFFFFF;
    color: #181330;
    border: 1px solid rgba(24, 19, 48, 0.16);
    border-radius: 9999px;
    font-weight: 500;
  }

  .btn-outline:hover {
    background-color: #FAF8F5;
    border-color: rgba(24, 19, 48, 0.28);
    transform: translateY(-1px);
  }

  /* Arrow animation */
  .btn-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.18s ease;
  }

  .eo-btn:hover .btn-arrow {
    transform: translateX(3px);
  }
</style>
