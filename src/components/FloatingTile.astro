---
import FloatingTile from './ui/FloatingTile.astro';
import type { TilePosition } from '../types/hero';

interface Props {
  icon: string;
  label: string;
  sublabel?: string;
  position?: TilePosition;
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
  rotate?: string;
  scale?: string;
  duration?: string;
  delay?: string;
  id?: string;
  class?: string;
}
---

<FloatingTile {...Astro.props} />
