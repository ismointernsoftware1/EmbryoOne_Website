---
// SecuritySection.astro
---

<section class="security-section" id="security">
  <div class="security-container">
    
    <!-- Top Header Row -->
    <div class="security-header">
      <div class="header-left">
        <h2 class="security-title">Enterprise security, built at the edge</h2>
        <p class="security-description">
          The models and telemetry your teams run operate directly on your local hardware, behind your enterprise identity provider, with continuous integrity verification. The controls your security and compliance teams expect are active by default.
        </p>
      </div>
      
      <div class="header-right">
        <div class="badge-row">
          <span class="compliance-badge">SOC 2 Type II</span>
          <span class="compliance-badge">ISO 27001</span>
          <span class="compliance-badge">IEC 62443</span>
          <span class="compliance-badge">SSO / SAML</span>
        </div>
        <a href="#security-governance" class="security-cta">See the full security and governance story</a>
      </div>
    </div>

    <!-- Divider -->
    <div class="section-divider"></div>

    <!-- Bottom 4-Column Feature Grid -->
    <div class="feature-grid">
      
      <!-- Column 1 -->
      <div class="feature-col">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
        </div>
        <h3 class="feature-title">On your infrastructure</h3>
        <p class="feature-desc">
          Runs entirely on your edge hardware and on-prem gateways. EmbryoOne retains zero telemetry copies and never phones raw sensor data home.
        </p>
      </div>

      <!-- Column 2 -->
      <div class="feature-col">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
          </svg>
        </div>
        <h3 class="feature-title">Access you control</h3>
        <p class="feature-desc">
          SSO, SAML 2.0, SCIM directory syncing, and granular role-based access control down to individual PLC and sensor nodes.
        </p>
      </div>

      <!-- Column 3 -->
      <div class="feature-col">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="feature-title">Audits on every cycle</h3>
        <p class="feature-desc">
          Every firmware push and logic rule receives cryptographically signed verification with tamper-proof audit logs your compliance team can inspect.
        </p>
      </div>

      <!-- Column 4 -->
      <div class="feature-col">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <line x1="6" y1="3" x2="6" y2="15"></line>
            <circle cx="18" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <path d="M18 9a9 9 0 0 1-9 9"></path>
          </svg>
        </div>
        <h3 class="feature-title">Your models, yours to keep</h3>
        <p class="feature-desc">
          All trained weights, custom rule graphs, and deployment configurations remain strictly your proprietary intellectual property from day one.
        </p>
      </div>

    </div>
    
    <!-- Bottom Accent Line -->
    <div class="accent-line"></div>
    
  </div>
</section>

<style>
  /* ── Section Canvas ── */
  .security-section {
    background-color: var(--color-white, #FFFFFF);
    padding: 100px 0;
    font-family: var(--font-primary, 'Inter', sans-serif);
  }

  .security-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Header Row ── */
  .security-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: 48px;
  }

  .header-left {
    flex: 1.2;
  }

  .security-title {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 700;
    color: var(--color-ink-deep, #120C1F);
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .security-description {
    font-size: 16px;
    color: var(--color-dove, #5C5566);
    line-height: 1.6;
    max-width: 600px;
  }

  .header-right {
    flex: 0.8;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
  }

  /* ── Badges ── */
  .badge-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .compliance-badge {
    border-radius: 9999px;
    border: 1px solid var(--color-parchment-border, #ECEAE4);
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-dove, #5C5566);
    background-color: var(--color-white, #FFFFFF);
    white-space: nowrap;
  }

  /* ── CTA Button ── */
  .security-cta {
    background-color: var(--color-ink-deep, #120C1F);
    color: var(--color-white, #FFFFFF);
    font-size: 14px;
    font-weight: 500;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .security-cta:hover {
    background-color: #2D263B;
  }

  /* ── Divider ── */
  .section-divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-parchment-border, #ECEAE4);
  }

  /* ── Feature Grid ── */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .feature-col {
    padding: 32px;
    border-right: 1px solid var(--color-parchment-border, #ECEAE4);
    display: flex;
    flex-direction: column;
  }

  .feature-col:last-child {
    border-right: none;
  }

  .feature-icon {
    color: var(--color-ink-deep, #120C1F);
    margin-bottom: 24px;
  }

  .feature-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-ink-deep, #120C1F);
    margin-bottom: 32px;
    letter-spacing: -0.01em;
  }

  .feature-desc {
    font-size: 14px;
    color: var(--color-dove, #5C5566);
    line-height: 1.5;
    margin-top: auto;
  }

  /* ── Accent Line ── */
  .accent-line {
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-iris) 0%, var(--color-brand) 50%, var(--color-orchid) 100%);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .feature-col:nth-child(2) {
      border-right: none;
    }
    
    .feature-col:nth-child(1),
    .feature-col:nth-child(2) {
      border-bottom: 1px solid var(--color-parchment-border, #ECEAE4);
    }
  }

  @media (max-width: 768px) {
    .security-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }
    
    .header-right {
      align-items: flex-start;
      width: 100%;
    }

    .badge-row {
      justify-content: flex-start;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }
    
    .feature-col {
      border-right: none;
      border-bottom: 1px solid var(--color-parchment-border, #ECEAE4);
    }

    .feature-col:last-child {
      border-bottom: none;
    }
  }
</style>
