---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import EnterpriseShowcase from '../components/EnterpriseShowcase.astro';
import FeatureBentoGrid from '../components/FeatureBentoGrid.astro';
import PlatformStackSection from '../components/PlatformStackSection.jsx';
import FeaturesSection from '../components/sections/FeaturesSection.astro';
import SecuritySection from '../components/SecuritySection.astro';

import { heroData, heroTiles, heroNetworkPaths } from '../data/hero';
import { featuresData } from '../data/features';
import { footerData } from '../data/footer';
---

<Layout title="EmbryoOne — Connect Intelligence to the Real World">
	<Header />
	<main>
		<!-- Integrated Hero Section with Floating Tiles, Animated Network & Product Showcase -->
		<Hero 
			{...heroData} 
			tiles={heroTiles} 
			networkPaths={heroNetworkPaths} 
		/>

		<!-- Enterprise Showcase Card with GSAP ScrollReveal -->
		<EnterpriseShowcase />

		<!-- Editorial Bento Grid Feature Showcase -->
		<FeatureBentoGrid />

		<!-- ScrollStack Platform Capabilities Section ("Get to know us" Stacking Cards) -->
		<PlatformStackSection client:load />

		<!-- Features & Capabilities Grid Section -->
		<FeaturesSection {...featuresData} />
		
		<!-- Enterprise Security & Governance Section -->
		<SecuritySection />
	</main>

	<Footer {...footerData} />
</Layout>

<style>
	main {
		width: 100%;
	}
</style>
