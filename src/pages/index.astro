---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';

import HeroSection from '../components/HeroSection.tsx';
import EnterpriseShowcase from '../components/EnterpriseShowcase.astro';
import FeatureBentoGrid from '../components/FeatureBentoGrid.astro';
import PlatformStackSection from '../components/PlatformStackSection.jsx';
import FeaturesSection from '../components/sections/FeaturesSection.astro';
import SecuritySection from '../components/SecuritySection.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/footer/Footer.tsx';

import { featuresData } from '../data/features';
---

<Layout
  title="EmbryoOne — Connect Intelligence to the Real World"
  description="Bring AI, hardware, IoT and software together in one intelligent platform built for the real world."
>
  <!-- HEADER -->
  <Header />

  <main>
    <!-- COLLEAGUE HERO -->
    <HeroSection client:load />

    <!-- ENTERPRISE SHOWCASE -->
    <EnterpriseShowcase />

    <!-- FEATURE BENTO GRID -->
    <FeatureBentoGrid />

    <!-- PLATFORM STACK SECTION -->
    <PlatformStackSection client:load />

    <!-- FEATURES SECTION -->
    <FeaturesSection {...featuresData} />

    <!-- SECURITY SECTION -->
    <SecuritySection />

    <!-- FAQ SECTION -->
    <FAQ />
  </main>

  <!-- FOOTER -->
  <Footer client:visible />
</Layout>

<style>
  main {
    width: 100%;
  }
</style>

