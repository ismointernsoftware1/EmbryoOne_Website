---
import "../styles/tailwind-bridge.css";
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "EmbryoOne — Connect Intelligence to the Real World",
	description = "Bring AI, hardware, IoT and software together in one intelligent platform built for the real world.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#CB6CE6" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />

		<!-- DM Sans Google Font (400, 500, 600, 700) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Typography */
		--font-primary:
			"DM Sans", "Inter", ui-sans-serif, system-ui, sans-serif;

		/* Ambient Aurora Mesh Glow Palette Tokens (EmbryoOne Style Guide) */
		--glow-color-1: #cb6ce6; /* Primary Embryo Purple */
		--glow-color-2: #5b3ac4; /* Secondary Iris Accent */
		--glow-color-3: #c453e4; /* Vivid Orchid Shade */
		--glow-color-4: #f3e0fb; /* Soft Lavender Blush */
		--glow-color-5: #3b2166; /* Twilight Ink */
		--glow-base: #ffffff;

		/* Brand — sourced from EmbryoOne logo */
		--color-brand: #cb6ce6; /* Embryo Purple — primary */
		--color-brand-hover: #ad52d0; /* Lavender Purple */
		--color-brand-active: #a35ac8; /* Lavender Purple 2 */
		--color-amethyst: #9a4dc1; /* logo wordmark / links */
		--color-orchid: #c759e1; /* Vivid Orchid — secondary */
		--color-violet: #db97f5; /* soft highlight / chips */

		/* Ink & accent */
		--color-ink: #181330;
		--color-ink-deep: #120c1f;
		--color-twilight: #3b2166;
		--color-iris: #5b3ac4; /* blue replacement */

		/* Neutral — Lovable-inspired warm surfaces */
		--color-white: #ffffff;
		--color-parchment: #f7f4ed;
		--color-linen: #faf8f5; /* Warm off-white for editorial sections */
		--color-parchment-border: #eceae4;
		--color-lavender: #f3e6fb;
		--color-mist: #e4dfea;
		--color-dove: #5c5566;
		--color-steel: #888494;

		/* Functional — ZERO BLUE RULE */
		--color-danger: #e54840;
		--color-success: #2f9e68;
		--color-warning: #e2a63d;
		--color-info: #5b3ac4; /* = Iris, never blue */

		/* Radius */
		--radius-sm: 8px;
		--radius-md: 12px;
		--radius-lg: 16px;
		--radius-xl: 20px;
		--radius-2xl: 24px;
		--radius-pill: 999px;

		/* Shadow */
		--shadow-sm: 0 1px 2px rgba(18, 12, 31, 0.05);
		--shadow-md: 0 4px 16px rgba(18, 12, 31, 0.06);
		--shadow-lg: 0 16px 48px rgba(18, 12, 31, 0.14);
		--shadow-glow: 0 0 24px rgba(203, 108, 230, 0.18);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	:where(body, h1, h2, h3, h4, h5, h6, p, figure, blockquote, dl, dd) {
		margin: 0;
		padding: 0;
	}

	html {
		font-family: var(--font-primary);
		background-color: var(--color-parchment);
		color: var(--color-ink);
		font-size: 16px;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		text-rendering: optimizeLegibility;
		scroll-behavior: smooth;
		overflow-x: hidden;
	}

	body {
		min-height: 100vh;
		background-color: var(--color-parchment);
		color: var(--color-ink);
		line-height: 1.5;
		overflow-x: hidden;
		display: flex;
		flex-direction: column;
	}

	/* Focus state styling conforming to zero blue rule (zero specificity) */
	:where(:focus-visible) {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}

	/* Typography defaults isolated via zero specificity */
	:where(h1, h2, h3, h4, h5, h6) {
		color: inherit;
		font-family: var(--font-primary);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	:where(a) {
		color: inherit;
		text-decoration: none;
	}

	:where(button, input, select, textarea) {
		font-family: inherit;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
